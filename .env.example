# Database connection string (e.g. Neon, Supabase, Vercel Postgres, AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/gatepass_db?sslmode=require

# JWT Secret for session authentication cookies
JWT_SECRET=sbjitmr-gatepass-secret-key-2024

# Secret for signing gate pass QR tokens
QR_SECRET=sbjitmr-qr-secret-2024

# Clerk Authentication Keys (From https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

